{# FIR draft. Reads `ev` (legal\evidence.py) and `fir` (what the officer
   entered, legal\fir.py). Officer-entered text is printed only inside elements
   of class "officer"; everything else comes from the evidence object. No
   account, amount, time or legal section is typed in this file. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>FIR draft {{ ev.case_id }}</title>
<style>
{% include "_print_css.j2" %}
</style>
</head>
<body>
<div class="page">
  <div class="draft">{{ ev.legal.draft_label }}</div>
  {% if not ev.legal.confirmed_with_mentors %}
  <div class="warn">Legal references on this page are defaults and have not yet been confirmed.</div>
  {% endif %}
  {% if ev.trace.low_confidence or ev.trace.truncated %}
  <div class="warn">
    {% if ev.trace.low_confidence %}The first transfer of this trace was followed on low confidence. {% endif %}
    {% if ev.trace.truncated %}This trace was cut short at the account limit. {% endif %}
    Review before signing.
  </div>
  {% endif %}

  <div class="meta">
    <div>
      Case id: <strong>{{ ev.case_id }}</strong><br>
      FIR number: {% if ev.fir_number %}<strong>{{ ev.fir_number }}</strong>{% else %}____________________{% endif %}
    </div>
    <div>Generated at: {{ ev.generated_at }}</div>
  </div>

  <h1>First Information Report</h1>
  <p>{{ ev.legal.fir }}.</p>

  <h2>1. Complainant (as entered by the officer)</h2>
  <table>
    <tbody>
      <tr><th>Name</th><td class="officer">{{ fir.complainant.name }}</td></tr>
      <tr><th>Address</th><td class="officer">{{ fir.complainant.address }}</td></tr>
      <tr><th>Phone</th><td class="officer">{{ fir.complainant.phone }}</td></tr>
      <tr><th>Email</th><td class="officer">{{ fir.complainant.email }}</td></tr>
      <tr><th>Police station / unit</th><td class="officer">{{ fir.police_station }}</td></tr>
      <tr><th>Sections of law</th><td class="officer">{{ fir.sections_of_law }}</td></tr>
      <tr><th>Complainant's account</th><td>{{ ev.victim.acct_no }} (IFSC {{ ev.victim.ifsc }})</td></tr>
    </tbody>
  </table>

  <h2>2. Summary of the offence (as entered by the officer)</h2>
  <div class="officer">{{ fir.offence_summary }}</div>

  <h2>3. What the transaction records show</h2>
  <p>
    A sum of <strong>{{ ev.totals.paid_paise | rupees }}</strong> was transferred from the complainant's account
    <strong>{{ ev.victim.acct_no }}</strong> between {{ ev.trace.first_ts }} and {{ ev.trace.last_ts }}. The money
    was followed through {{ ev.transfers | length }} transfer(s) to {{ ev.accounts | length }} account(s), set
    out in Annexures A and B. Of it, <strong>{{ ev.totals.freeze_holding_total_paise | rupees }}</strong> is
    assessed to be still held in the {{ ev.freeze_candidates | length }} account(s) of Annexure C.
  </p>

  <h2>Annexure A &mdash; Traced accounts</h2>
  <table>
    <thead>
      <tr><th>#</th><th>Account number</th><th>IFSC</th><th>Layer</th><th class="num">Received</th>
          <th class="num">Passed on</th><th class="num">Still held</th><th>Freeze recommended</th></tr>
    </thead>
    <tbody>
      {% for a in ev.accounts %}
      <tr><td>{{ loop.index }}</td><td>{{ a.acct_no }}</td><td>{{ a.ifsc }}</td><td>{{ a.role or "no role assigned" }}</td>
          <td class="num">{{ a.tainted_in_paise | rupees }}</td><td class="num">{{ a.tainted_out_paise | rupees }}</td>
          <td class="num">{{ a.holding_paise | rupees }}</td><td>{{ "Yes" if a.freeze_recommended else "No" }}</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Annexure B &mdash; Transfers followed</h2>
  <table>
    <thead>
      <tr><th>Date and time</th><th>Transaction ID</th><th>From account</th><th>To account</th>
          <th class="num">Amount</th><th class="num">Of which complainant's money</th></tr>
    </thead>
    <tbody>
      {% for t in ev.transfers %}
      <tr><td>{{ t.ts }}</td><td>{{ t.tx_id }}</td><td>{{ t.from }}</td><td>{{ t.to }}</td>
          <td class="num">{{ t.amount_paise | rupees }}</td><td class="num">{{ t.tainted_paise | rupees }}</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>Annexure C &mdash; Accounts recommended for freezing</h2>
  {% if ev.freeze_candidates %}
  <table>
    <thead>
      <tr><th>#</th><th>Account number</th><th>IFSC</th><th>Layer</th><th class="num">Amount to be frozen</th></tr>
    </thead>
    <tbody>
      {% for c in ev.freeze_candidates %}
      <tr><td>{{ loop.index }}</td><td>{{ c.acct_no }}</td><td>{{ c.ifsc }}</td><td>{{ c.role or "no role assigned" }}</td>
          <td class="num">{{ c.holding_paise | rupees }}</td></tr>
      {% endfor %}
      <tr><th colspan="4">Total</th><th class="num">{{ ev.totals.freeze_holding_total_paise | rupees }}</th></tr>
    </tbody>
  </table>
  {% else %}
  <p>No account that holds the complainant's money is recommended for freezing.</p>
  {% endif %}

  <div class="sign">
    <div></div><span>Signature</span>
    <div></div><span>Name and rank</span>
    <div></div><span>Police station / unit</span>
    <div></div><span>Date</span>
  </div>

  <div class="foot">
    <table>
      <tr><th>Case id</th><td>{{ ev.case_id }}</td><th>Generated at</th><td>{{ ev.generated_at }}</td></tr>
      <tr><th>Profile id</th><td>{{ ev.profile_id }}</td><th>Generator</th><td>{{ ev.generator }}</td></tr>
      <tr><th>Dataset SHA-256</th><td colspan="3" class="mono">{{ ev.dataset.sha256 }}</td></tr>
      <tr><th>Trace fingerprint</th><td colspan="3" class="mono">{{ ev.fingerprint }}</td></tr>
    </table>
    <strong>{{ ev.legal.draft_label }}</strong>
  </div>
</div>
</body>
</html>
